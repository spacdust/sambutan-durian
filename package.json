{
  "name": "chat-sambutan-durian",
  "version": "1.0.0",
  "description": "Sambutan Durian - WhatsApp Web Admin & Connection Platform",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-baileys.mjs",
    "dev": "node scripts/ensure-ui.mjs && tsx watch src/index.ts",
    "dev:ui": "npm --prefix admin-ui run dev",
    "build:ui": "node scripts/build-ui.mjs",
    "build": "tsc && npm run build:ui",
    "start": "node dist/index.js"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "web-admin",
    "dashboard",
    "durian"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^5.7.3"
  }
}
