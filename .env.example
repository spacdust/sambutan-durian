# Sambutan Durian - WhatsApp Automation & Web Admin
NODE_ENV=development
HOST=0.0.0.0
PORT=3009

# Admin Security
ADMIN_PASSWORD=admin-dev-only

# Database (Default: sqlite via built-in node:sqlite, zero setup!)
DB_DRIVER=sqlite
SQLITE_PATH=./data/durian.db
DATABASE_URL=

# Anti-Ban / Delays
MIN_DELAY_SECONDS=3
MAX_DELAY_SECONDS=5

# Logging
LOG_LEVEL=info
